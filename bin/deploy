#!/usr/bin/env bash
# Deploys HEAD to GitHub and to the kamal server, refreshes the sitemap and purges the Cloudflare cache.
# Purges Cloudflare immediately if CLOUDFLARE_API_TOKEN (Zone > Cache Purge) and CLOUDFLARE_ZONE_ID are in .env;
# otherwise pages refresh within the hour.
set -euo pipefail

HOST=theoriemusicale.camilleroux.com

git push origin HEAD:master
bin/kamal deploy
bin/kamal sitemap

token=$(grep '^CLOUDFLARE_API_TOKEN=' .env | cut -d= -f2- || true)
zone=$(grep '^CLOUDFLARE_ZONE_ID=' .env | cut -d= -f2- || true)
if [ -z "$token" ] || [ -z "$zone" ]; then
  echo "No Cloudflare credentials: pages will refresh within the hour (s-maxage)"
  exit 0
fi

purge() {
  curl -sS -X POST "https://api.cloudflare.com/client/v4/zones/$zone/purge_cache" \
    -H "Authorization: Bearer $token" -H "Content-Type: application/json" --data "$1"
}

result=$(purge "{\"hosts\":[\"$HOST\"]}")
if ! grep -q '"success":[[:space:]]*true' <<< "$result"; then
  echo "Purge by host failed ($result), purging the whole zone" >&2
  result=$(purge '{"purge_everything":true}')
fi
grep -q '"success":[[:space:]]*true' <<< "$result" && echo "Cloudflare cache purged" || { echo "Cloudflare purge failed: $result" >&2; exit 1; }

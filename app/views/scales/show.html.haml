-# A scale with one mode (par tons) is that mode: in a key, its mode page holds the searches
- canonical = @key && @scale.modes.one? ? url_for([@key, @scale, @scale.main_mode, {only_path: false}]) : url_for([@key, @scale, {only_path: false}])
-set_meta_tags canonical: canonical
- add_defined_term(name: @scale.heading, description: @scale.seo_description, url: canonical, set_name: 'Gammes et modes', set_url: scales_url)

= breadcrumb(['Gammes', scales_path], [@scale.heading, url_for([@key, @scale])])

%article#scale
  %header.detail-hero.card
    .card-body
      -title @scale.seo_title
      -description @scale.seo_description
      %h1.mb-3= @scale.heading
      %p.mb-3= typo_fr(@scale.information)
      %dl.detail-hero__facts
        %dt Notes
        %dd
          - @scale.keys.each do |key|
            = link_to key, note_path(key), title: key.name_for_seo, class: 'badge bg-light'
        %dt Intervalles
        %dd
          - @scale.intervals.each do |i|
            = link_to i.long_name, interval_path(i), class: 'badge bg-primary'
        %dt Modes
        %dd= @scale.modes.count

  %nav#modes-list
    %h2= @key ? (@scale.modes.one? ? 'Mode' : "Les #{@scale.modes.count} modes") : 'Modes de la gamme'
    .table-responsive
      %table.table.table-hover.table-striped
        %thead
          %tr
            %th Degré
            -if @scale.heptatonic?
              %th Mode (Appellation moderne)
            %th Mode (Appellation courante)
            %th Séquence d'intervalles en tons
        %tbody
          - @scale.modes.order(:mode).each do |mode|
            - mode = mode.in_key_of(@scale.key || 'C')
            %tr
              %td= mode.degree
              -if @scale.heptatonic?
                %td= link_to "Mode de #{mode.mode_key}", [@key, @scale, mode]
              %td
                = link_to mode, [@key, @scale, mode]
              %td
                = mode.step_names.join(" - ")

  -if @scale.heptatonic?
    %nav#harmonization
      %h2 Harmonisation de la #{@scale.name_in_key}
      =render partial: 'harmonization', locals: {scale: @scale}

= render 'shared/faq', title: "Questions sur la #{@scale.name_in_key}", items: Faq.for_scale(@scale)

-description "Le mode #{@mode.title}, issu de la gamme #{@scale.name}, est composé des intervalles suivants : #{@mode.step_names.join(" - ")}"
-set_meta_tags canonical: url_for([@key, @scale, @mode, {only_path: false}])

%ol.breadcrumb{itemscope: true, itemtype: "https://schema.org/BreadcrumbList"}
  %li.breadcrumb-item{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: root_path, title: "Théorie de la musique"}
      %span{itemprop: "name"}>= "Théorie musicale"
    %meta{itemprop: "position", content: "1"}
  %li.breadcrumb-item{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: scales_path, title: "Gammes"}
      %span{itemprop: "name"}>= "Gammes"
    %meta{itemprop: "position", content: "2"}
  %li.breadcrumb-item{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: scale_path(@scale), title: @scale.title}
      %span{itemprop: "name"}>= @scale.title
    %meta{itemprop: "position", content: "3"}
  %li.breadcrumb-item.active{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: url_for([@key, @scale, @mode]), title: @mode.title, class: "disable"}
      %span{itemprop: "name"}>= "Mode #{@mode.title}"
    %meta{itemprop: "position", content: "4"}

%article#scale
  %header
    .page-header
      %h1= title "Mode #{@mode.title}"


%section#mode
  .row.g-4
    .col-12.col-md-6
      .card.h-100.shadow-sm.border-0
        .card-header.bg-transparent
          Notation
        .card-body.d-flex.align-items-center.justify-content-center
          .staff.scale-staff{"data-id" => @scale.id, "data-easyscore" => @mode.staff_easyscore, "data-clef" => "treble", "data-width" => 400, "data-height" => 150}
    .col-6.col-md-3
      .card.h-100.shadow-sm.border-0
        .card-header.bg-transparent
          Notes
        .card-body.d-flex.align-items-center.justify-content-center
          .d-flex.flex-wrap.justify-content-center
            - @mode.keys.each do |key|
              = link_to key, note_path(key), title: key.name_for_seo, class: 'badge bg-light text-dark text-decoration-none border me-1 mb-1 fs-6'
    .col-6.col-md-3
      .card.h-100.shadow-sm.border-0
        .card-header.bg-transparent
          Intervalles
        .card-body.d-flex.align-items-center.justify-content-center
          .text-center.fs-5=@mode.step_names.join(", ")

%section#piano.mt-3
  %h3 Mode #{@mode.title} au piano
  =render "layouts/piano", keys: @mode.keys

  -if @scale.heptatonic?
    %nav#harmonization.mt-3
      %h2
        Harmonisation du mode #{@mode.title}
        %small.text-muted #{@scale.title}
      =render partial: 'scales/harmonization', locals: {scale: @scale, mode: @mode}


  - unless @mode.chord_scales.empty?
    %nav.related-chords.mt-3
      %h3 Accords associés :
      .chords-list.row.row-cols-1.row-cols-md-2.row-cols-lg-3.g-4
        - @mode.chord_scales.each do |chord_scale|
          = render chord_scale.chord, :key => (@scale.key || Key.default).shifted(-1 * chord_scale.offset)

%nav#key-selector.mt-5
  .card
    .card-header
      Afficher dans la tonalité
    .card-body
      %nav
        %ul.pagination
          - Key.primaries.each do |key|
            %li.page-item{:class => ("active" if @key == key || (@key.nil? && key.name == "C"))}= link_to key, [key, @scale, @mode], class: "page-link"


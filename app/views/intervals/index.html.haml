-set_meta_tags canonical: intervals_url

%ol.breadcrumb{itemscope: true, itemtype: "https://schema.org/BreadcrumbList"}
  %li.breadcrumb-item{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: root_path, title: "Théorie de la musique"}
      %span{itemprop: "name"}>= "Théorie musicale"
    %meta{itemprop: "position", content: "1"}
  %li.breadcrumb-item.active{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: intervals_path, title: "Intervalles", class: "disable"}
      %span{itemprop: "name"}>="Intervalles"
    %meta{itemprop: "position", content: "2"}

.page-header
  %h1= title "Intervalles"
%h2.lead= description 'Liste des intervalles et de leurs équivalents enharmoniques'

#section#intervals
  %h2 Intervalles simples
  %table.table.table-hover.table-sm
    %thead
      %tr
        %th Intervalle
        %th Seconde note par rapport à C
        %th Nombre de tons
        %th Nombre de demi-tons

    %tbody
    -@intervals.select {|i| i.degree < 8  }.each do |interval|
      %tr{class: interval.semitones.even? ? "table-active" : ""}
        %td
          %strong= link_to interval.long_name, interval_path(interval), title: interval.long_name
        -key = Key.from_index(interval.semitones, interval.letter_index)
        %td= link_to key, note_path(key), title: key.name_for_seo
        %td= number_to_human(interval.semitones / 2.0, precision: 3)
        %td= interval.semitones

  %h2 Intervalles redoublés
  %table.table.table-hover.table-sm
    %thead
      %tr
        %th Intervalle
        %th Seconde note par rapport à C
        %th Nombre de tons
        %th Nombre de demi-tons

    %tbody
    -@intervals.select {|i| i.degree >= 8  }.each do |interval|
      %tr{class: interval.semitones.even? ? "table-active" : ""}
        %td
          %strong= link_to interval.long_name, interval_path(interval), title: interval.long_name
        -key = Key.from_index(interval.semitones, interval.letter_index)
        %td= link_to key, note_path(key), title: key.long_name
        %td= number_to_human(interval.semitones / 2.0, precision: 3)
        %td= interval.semitones
-set_meta_tags canonical: intervals_url

%ol.breadcrumb{itemscope: true, itemtype: "https://schema.org/BreadcrumbList"}
  %li.breadcrumb-item{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: root_path, title: "Théorie de la musique"}
      %span{itemprop: "name"}>= "Théorie musicale"
    %meta{itemprop: "position", content: "1"}
  %li.breadcrumb-item.active{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: intervals_path, title: "Intervalles", class: "disable"}
      %span{itemprop: "name"}>="Intervalles"
    %meta{itemprop: "position", content: "2"}

.page-header
  %h1= title "Intervalles"
  %p.lead= description 'Les intervalles simples et redoublés, avec leur nom et leur symbole'

%p.text-muted Intervalles regroupés par taille. En bleu les intervalles usuels (justes, majeurs, mineurs), en contour leurs équivalents diminués ou augmentés. La note indiquée part de do.

- groups = [['Intervalles simples', @intervals.select { |i| i.degree < 8 }], ['Intervalles redoublés', @intervals.select { |i| i.degree >= 8 }]]
- groups.each do |name, intervals|
  %section.mb-5
    %h2= name
    .group-list.card
      - intervals.group_by(&:semitones).sort.each do |semitones, group|
        .group-list__row
          .group-list__label
            %strong= "#{semitones} demi-ton#{'s' if semitones > 1}"
            %span= group.first.tones_label
          .group-list__items
            - group.sort_by { |i| [:J, :M, :m].include?(i.quality) ? 0 : 1 }.each do |interval|
              - key = Key.from_index(interval.semitones, interval.letter_index)
              = link_to interval_path(interval), class: "chip #{[:J, :M, :m].include?(interval.quality) ? 'chip--main' : 'chip--alt'}", title: "#{interval.long_name} : de C à #{key}" do
                %span.chip__name= interval.long_name
                %span.chip__note= "C → #{key}"

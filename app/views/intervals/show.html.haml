-description "L'intervalle de #{@interval.long_name_with_key} est composé de #{pluralize(number_to_human(@interval.semitones / 2.0),'ton')}"
-set_meta_tags canonical: @key ? key_interval_url(@key, @interval) : interval_url(@interval)

%ol.breadcrumb{itemscope: true, itemtype: "https://schema.org/BreadcrumbList"}
  %li.breadcrumb-item{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: root_path, title: "Théorie de la musique"}
      %span{itemprop: "name"}>= "Théorie musicale"
    %meta{itemprop: "position", content: "1"}
  %li.breadcrumb-item{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: intervals_path, title: "Intervalles"}
      %span{itemprop: "name"}>= "Intervalles"
    %meta{itemprop: "position", content: "2"}
  %li.breadcrumb-item.active{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: (@key ? key_interval_path(@key, @interval) : interval_path(@interval)), title: @interval.long_name_with_key, class: "disable"}
      %span{itemprop: "name"}>= @interval.long_name_with_key
    %meta{itemprop: "position", content: "3"}

.page-header
  %h1
    = title @interval.long_name_with_key
    %small= @interval.symbol


%section#note
  .row.g-3
    .col-12.col-md-3
      .card.h-100
        .card-header
          Notation
        .card-body.d-flex.align-items-center.justify-content-center
          .staff.interval-staff{"data-id" => @interval.to_param, "data-easyscore" => @interval.staff_easyscore, "data-clef" => "treble", "data-width" => 200, "data-height" => 150}
    .col-6.col-md-3
      .card.h-100
        .card-header
          Symbole
        .card-body.d-flex.align-items-center.justify-content-center
          %h3.mb-0.fw-bold.text-primary.display-3=@interval.symbol
    .col-6.col-md-3
      .card.h-100
        .card-header
          Tons
        .card-body.d-flex.align-items-center.justify-content-center
          %h3.mb-0.fw-bold.text-primary.display-3= number_to_human(@interval.semitones / 2.0, precision: 3)
    .col-6.col-md-3
      .card.h-100
        .card-header
          Demi-tons
        .card-body.d-flex.align-items-center.justify-content-center
          %h3.mb-0.fw-bold.text-primary.display-3= @interval.semitones


%section.infos.mt-3
  %h3 Informations complémentaires
  - unless @interval.compound?
    %p
      %label Renversement :
      - inversion = @interval.inversion
      =link_to inversion.long_name, interval_path(inversion)
  %p
    %label Type d'intervalle :
    Intervalle
    = @interval.compound? ? 'redoublé' : 'simple'
  %p
    %label Seconde note par rapport à #{@interval.notes.first} :
    = link_to @interval.keys.last, note_path(@interval.keys.last), title: @interval.keys.last.long_name

%section#piano.mt-3
  %h3 #{@interval.name_with_key} au piano
  =render "layouts/piano", keys: @interval.keys


%nav#key-selector.mt-5
  .card
    .card-header
      Afficher la #{@interval.long_name} de
    .card-body
      .nav
        %ul.pagination
          - Key.primaries.each do |key|
            %li.page-item{:class => ("active" if @key == key)}= link_to key, key_interval_path(key, @interval), class: "page-link"




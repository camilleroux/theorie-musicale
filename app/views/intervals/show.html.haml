-title @interval.seo_title
-description @interval.seo_description
-set_meta_tags canonical: @key ? key_interval_url(@key, @interval) : interval_url(@interval)
- add_defined_term(name: @interval.heading, code: @interval.symbol, description: @interval.seo_description.sub(/ Position .*\z/, ''),
  url: (@key ? key_interval_url(@key, @interval) : interval_url(@interval)), set_name: 'Intervalles', set_url: intervals_url)

= breadcrumb(['Intervalles', intervals_path], [@interval.heading, (@key ? key_interval_path(@key, @interval) : interval_path(@interval))])

%header.detail-hero.card
  .card-body
    .row.g-4.align-items-center
      .col-12.col-lg-6
        %h1.detail-hero__title
          %span.detail-hero__symbol.detail-hero__symbol--text= @interval.heading
          = ' '
          %span.detail-hero__name= "#{@interval.tones_label} · #{@interval.semitones} demi-ton#{'s' if @interval.semitones > 1}"
        %dl.detail-hero__facts
          %dt Notes
          %dd
            - @interval.keys.each do |key|
              = link_to key, note_path(key), title: key.name_for_seo, class: 'badge bg-light'
          %dt Symbole
          %dd= @interval.symbol
          %dt Type
          %dd= @interval.compound? ? 'Intervalle redoublé' : 'Intervalle simple'
          - unless @interval.compound?
            %dt Renversement
            %dd
              - inversion = @interval.inversion
              = link_to inversion.long_name, interval_path(inversion), class: 'badge bg-primary'
      .col-12.col-lg-6
        .detail-hero__staff
          .staff.interval-staff{"data-id" => @interval.to_param, "data-staff" => @interval.octavized_notes.map {|n| [n]}.to_json, "data-staff-clef" => "treble", "width" => 260}
          = play_buttons(@interval.octavized_notes, :chord, :arpeggio)
  .card-footer
    = render 'shared/key_selector', current: @key, path: ->(key) { key_interval_path(key, @interval) }

%section.detail-intro
  %p.lead= typo_fr(@interval.seo_description.sub(/ Position .*\z/, ""))

%section#piano
  %h2.h3 #{@interval.heading} au piano
  = piano_image_tag(@interval)

- if (songs = IntervalSong.for(@interval))
  %section#oreille.mt-5
    - name = @interval.long_name.downcase
    %h2.h3 Reconnaître #{name.start_with?('o') ? "l'" : 'la '}#{name} à l'oreille
    %p= typo_fr("Ces standards de jazz commencent par une #{@interval.long_name.downcase} : chantez leurs deux premières notes pour retrouver l'intervalle.")
    .play-buttons.play-buttons--row.mb-3{role: 'group', 'aria-label': "Écouter : #{name}"}
      = play_notes_button(@interval.octavized_notes, :melody, 'Montant')
      = play_notes_button(@interval.octavized_notes.reverse, :melody, 'Descendant')
    = render 'intervals/songs', songs: songs
    %p.mt-3
      = link_to "Tous les intervalles à l'oreille", ear_training_path

= render 'shared/faq', title: "Questions sur #{@interval.heading.start_with?('O') ? "l'" : 'la '}#{@interval.heading.sub(/\A\w/, &:downcase)}", items: Faq.for_interval(@interval)

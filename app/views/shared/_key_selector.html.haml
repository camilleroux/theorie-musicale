-# locals: current (Key or nil for C), path (lambda key -> path),
-# keys (optional, [label, key] pairs, e.g. a mode's tonics with their parent keys)
- keys = local_assigns[:keys] || Key.primaries.map { |key| [key, key] }
%nav.key-selector{'aria-label': 'Tonalité'}
  %span.key-selector__label Tonalité
  %ul.pagination.pagination-sm
    - keys.each do |label, key|
      - active = current ? current == key : key.main?
      %li.page-item{class: ('active' if active)}
        = link_to label, path.(key), class: 'page-link', 'aria-current': (active ? 'page' : nil)

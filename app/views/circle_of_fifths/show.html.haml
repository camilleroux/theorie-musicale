-title SeoTitle.fit('Cycle des quintes', [' interactif : armures et II-V-I', ' interactif : armures et accords', ' interactif'])
-description "Cycle des quintes interactif : les 12 tonalités majeures et leurs relatives mineures, leurs armures, leurs accords, leur II-V-I et la substitution tritonique, pour le jazz et l'improvisation."
-set_meta_tags canonical: circle_of_fifths_url
- add_defined_term(name: 'Cycle des quintes', alternate_names: ['Cercle des quintes'], url: circle_of_fifths_url, set_name: 'Théorie musicale', set_url: root_url,
  description: "Le cycle des quintes range les 12 tonalités majeures en cercle, chacune une quinte au-dessus de la précédente dans le sens des aiguilles d'une montre. Deux tonalités voisines ne diffèrent que d'une altération.")

%ol.breadcrumb
  %li.breadcrumb-item= link_to 'Théorie musicale', root_path
  %li.breadcrumb-item.active Cycle des quintes

%article#circle-of-fifths
  .page-header
    %h1 Cycle des quintes
  %section.detail-intro
    %p.lead= typo_fr("Le cycle des quintes (ou cercle des quintes) range les 12 tonalités majeures en cercle : dans le sens des aiguilles d'une montre, chaque tonalité est une quinte au-dessus de la précédente et gagne un dièse (ou perd un bémol). Deux tonalités voisines ne diffèrent que d'une note, et la relative mineure de chaque tonalité est écrite juste en dessous.")
    %p= typo_fr("Choisissez une tonalité pour voir son armure, ses accords, son II-V-I et sa substitution tritonique, et les écouter.")

  .row.g-4.align-items-start.circle-layout
    .col-12.col-lg-6
      .circle-wrapper= circle_of_fifths_svg(@positions)
    .col-12.col-lg-6
      - @positions.each do |position|
        - tonic = position.tonic
        - minor = position.relative_minor
        - ii_v_i = position.ii_v_i
        - substitute = position.tritone_substitute
        - minor_ii_v_i = position.minor_ii_v_i
        %section.circle-panel.card{id: position.anchor, data: { circle_panel: position.anchor }}
          .card-body
            %h2.h3.mt-0 #{tonic.french_long_name.upcase_first} majeur (#{position.name})
            %dl.detail-hero__facts.mb-3
              %dt Armure
              %dd= typo_fr(position.signature_text.upcase_first)
              %dt Relative
              %dd= link_to "#{minor.french_long_name} mineur (#{position.minor_name})", circle_mode_path(tonic, 'eolien')
              %dt Voisines
              %dd
                - CircleOfFifths.neighbours(position, @positions).each do |neighbour|
                  = link_to neighbour.name, "##{neighbour.anchor}", class: 'badge bg-light', data: { circle_key: neighbour.anchor }
            %h3.h6 Accords de la tonalité
            .table-responsive
              %table.table.table-sm.text-center.circle-panel__chords
                %tr
                  - position.diatonic_chords.each do |roman, _|
                    %th= roman
                %tr
                  - position.diatonic_chords.each do |_, chord|
                    %td= circle_chord_link(chord)
            %h3.h6 II-V-I
            .circle-panel__progression.mb-3
              = safe_join(ii_v_i.map { |chord| circle_chord_link(chord) }, ' – ')
              = play_buttons(ii_v_i.map(&:octavized_notes), :progression)
            %p.small
              = typo_fr("Substitution tritonique : on remplace #{ii_v_i[1].display_symbol} par #{substitute.display_symbol}, à l'opposé sur le cercle, ce qui donne")
              = succeed '.' do
                = safe_join([ii_v_i[0], substitute, ii_v_i[2]].map { |chord| circle_chord_link(chord) }, ' – ')
            %h3.h6 En #{minor.french_long_name} mineur
            .circle-panel__progression.mb-3
              = safe_join(minor_ii_v_i.map { |chord| circle_chord_link(chord) }, ' – ')
              = play_buttons(minor_ii_v_i.map(&:octavized_notes), :progression)
            %p.small.mb-0
              = link_to "Gamme de #{tonic.french_long_name} majeur", circle_mode_path(tonic, 'ionien')
              ·
              = link_to "Gamme de #{minor.french_long_name} mineur naturel", circle_mode_path(tonic, 'eolien')
              - if (path = progression_in_key_path('ii-v-i-majeur', tonic))
                ·
                = link_to "II-V-I en #{tonic.french_long_name}", path

  %section.mt-5
    %h2 Lire le cycle des quintes
    %p= typo_fr("En partant de do majeur, sans altération, on monte d'une quinte à chaque cran : sol (1 dièse), ré (2 dièses), la, mi, si, puis fa♯ (6 dièses). De l'autre côté, on descend d'une quinte à chaque cran : fa (1 bémol), si♭ (2 bémols), mi♭, la♭, ré♭, puis sol♭ (6 bémols). Fa♯ et sol♭ se rejoignent en bas du cercle : ce sont deux noms pour la même tonalité (enharmonie).")
    %p= typo_fr("Les dièses s'ajoutent dans l'ordre fa, do, sol, ré, la, mi, si, et les bémols dans l'ordre inverse : si, mi, la, ré, sol, do, fa. Chaque nouvelle altération est elle-même une quinte au-dessus (ou au-dessous) de la précédente.")

  %section.mt-4
    %h2 Pourquoi les jazzmen l'ont toujours en tête
    %p
      = typo_fr("Dans le sens inverse des aiguilles d'une montre, les fondamentales descendent par quintes. C'est exactement le mouvement du")
      = link_to 'II-V-I', progression_path('ii-v-i-majeur')
      = typo_fr(": en do, Dm7 – G7 – Cmaj7 utilise trois cases voisines (ré, sol, do). Les dominantes secondaires prolongent la chaîne : A7 – D7 – G7 – C, comme dans")
      = succeed '.' do
        = link_to "l'anatole", progression_path('anatole')
    %p= typo_fr("La case opposée sur le cercle est à un triton : c'est là que se trouve la substitution tritonique de chaque dominante (D♭7 à la place de G7), qui partage avec elle sa tierce et sa septième.")
    %p= typo_fr("Faire le tour du cercle est enfin la méthode classique pour travailler un II-V-I, un voicing ou une phrase dans les 12 tonalités, sans en oublier aucune.")

  %section.mt-4
    %h2 Les 12 tonalités et leurs armures
    .table-responsive
      %table.table.table-striped.table-hover
        %thead
          %tr
            %th Tonalité majeure
            %th Relative mineure
            %th Armure
        %tbody
          - @positions.each do |position|
            %tr
              %td= link_to "#{position.tonic.french_long_name} majeur (#{position.name})", "##{position.anchor}", data: { circle_key: position.anchor }
              %td #{position.relative_minor.french_long_name} mineur (#{position.minor_name})
              %td= typo_fr(position.signature_text)

  = render 'shared/faq', title: 'Questions sur le cycle des quintes', items: circle_of_fifths_faq

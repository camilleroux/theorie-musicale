-title @chord.seo_title
-description @chord.seo_description
-set_meta_tags canonical: url_for([@chord.key, @chord, {only_path: false}])

%ol.breadcrumb{itemscope: true, itemtype: "https://schema.org/BreadcrumbList"}
  %li.breadcrumb-item{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: root_path, title: "Théorie de la musique"}
      %span{itemprop: "name"}>= "Théorie musicale"
    %meta{itemprop: "position", content: "1"}
  %li.breadcrumb-item{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: chords_path, title: "Accords"}
      %span{itemprop: "name"}>= "Accords"
    %meta{itemprop: "position", content: "2"}
  %li.breadcrumb-item.active{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: url_for([@chord.key, @chord]), title: @chord.title, class: "disable"}
      %span{itemprop: "name"}>= @chord.title(true)
    %meta{itemprop: "position", content: "3"}

%article#chord
  = render "chords/header"

= render "chords/guitar"

%section#piano.mt-3
  %h3 #{@chord.title(true)} au piano
  =render "layouts/piano", keys: @chord.keys

-if @chord.chord_scales.size > 1
  %nav.related-modes.mt-3
    %h3 Gammes et modes relatifs :
    .modes-list
      .row
        - @chord.chord_scales.includes(mode: [:scale]).each do |chord_scale|
          = render chord_scale.mode, :key => (@chord.key || Key.default).shifted(chord_scale.offset)


= render "chords/key_selector"


-set_meta_tags canonical: chords_url

- title 'Accords'
= breadcrumb(['Accords', chords_path])

.page-header
  %h1 Accords
  %p.lead= description 'Les accords classés par famille, avec leur symbole et leur composition'

%nav.quality-nav{'aria-label': "Familles d'accords"}
  - @chord_qualities.each do |quality|
    = link_to quality.heading, "##{quality.slug}", class: 'btn btn-outline-primary btn-sm'

%section#chords
  = render @chord_qualities

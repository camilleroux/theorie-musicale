%header
  .page-header.mb-5
    %h1.display-4.fw-bold
      = link_to_unless_current @chord.title(true), key_chord_path(@key||Key['C'], @chord), class: 'text-decoration-none text-dark'
      %span.text-primary= @chord.main_symbol_name

  .row.g-4
    .col-12.col-md-3
      .card.h-100.shadow-sm.border-0
        .card-header.bg-transparent
          Notation
        .card-body.d-flex.align-items-center.justify-content-center
          .staff.chord-staff{"data-id" => @chord.id, "data-easyscore" => @chord.staff_easyscore, "data-clef" => "treble", "data-width" => 200, "data-height" => 150}


    .col-6.col-md-3
      .card.h-100.shadow-sm.border-0
        .card-header.bg-transparent
          Symbole
        .card-body.d-flex.align-items-center.justify-content-center
          %h3.mb-0.fw-bold.text-primary.display-3=@chord.main_symbol_name
    .col-6.col-md-3
      .card.h-100.shadow-sm.border-0
        .card-header.bg-transparent
          Notes
        .card-body.d-flex.align-items-center.justify-content-center
          .d-flex.flex-wrap.justify-content-center
            - @chord.keys.each do |key|
              = link_to key, note_path(key), title: key.name_for_seo, class: 'badge bg-light text-dark text-decoration-none border me-1 mb-1 fs-6'
    .col-12.col-md-3
      .card.h-100.shadow-sm.border-0
        .card-header.bg-transparent
          Intervalles
        .card-body.d-flex.align-items-center.justify-content-center
          .d-flex.flex-wrap.justify-content-center
            - @chord.intervals.each do |i|
              = link_to i.long_name, interval_path(i), class: 'badge bg-primary bg-opacity-75 text-white text-decoration-none me-1 mb-1'

.clearfix

%nav.infos.mt-5.p-4.bg-white.rounded-3.shadow-sm
  %h3.h4.mb-3 Informations complémentaires
  %p.lead= @chord.information
  - if @chord.parent
    %p
      %strong Accord parent :
      = link_to @chord.parent, [@key, @chord.parent], class: 'text-decoration-none'
  - if @chord.other_symbol_names.present?
    %p
      %strong Autres symboles utilisées :
      #{@chord.other_symbol_names.join(', ')}
  %p
    %strong Nombre de notes :
    =@chord.notes.count
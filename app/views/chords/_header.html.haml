-# Hero summary: symbol, name, notes, intervals, staff and key selector in one block
%header.detail-hero.card
  .card-body
    .row.g-4.align-items-center
      .col-12.col-lg-6
        -# Reads "Accord Am7 la mineur 7" (or "Accord majeur 7 Cmaj7 do majeur 7" on the key-less page), like the searches
        %h1.detail-hero__title
          %span.detail-hero__kicker= @chord.key ? 'Accord' : "Accord #{@chord.name.downcase}"
          = ' '
          %span.detail-hero__symbol= @chord.in_c.display_symbol
          = ' '
          %span.detail-hero__name= @chord.in_c.full_name
        %dl.detail-hero__facts
          %dt Notes
          %dd
            - @chord.keys.each do |key|
              = link_to key, note_path(key), title: key.name_for_seo, class: 'badge bg-light'
          %dt Intervalles
          %dd
            - @chord.intervals.each do |i|
              = link_to i.long_name, interval_path(i), class: 'badge bg-primary'
          - if @chord.other_symbol_names.present?
            %dt Autres symboles
            %dd= @chord.other_symbol_names.join(', ')
          - if @chord.parent
            %dt Accord parent
            %dd= link_to @chord.parent.in_key_of(@chord.key || Key.default).heading, [@key, @chord.parent]
        - if @chord.information.present?
          %p.mb-0= @chord.information
      .col-12.col-lg-6
        .detail-hero__staff
          .staff.chord-staff{"data-id" => @chord.id, "data-staff" => @chord.octavized_notes.to_json, "data-staff-clef" => "treble", "width" => 260}
          = play_buttons(@chord.octavized_notes, :chord, :arpeggio)
  .card-footer
    = render "chords/key_selector"

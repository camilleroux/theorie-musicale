- chord = chord.in_key_of(key) if local_assigns[:key]

.col
  .chord
    .card.h-100
      = link_to(chord) do
        .card-header.text-center.fw-bold.text-uppercase.bg-primary.text-white
          =chord.name
        .card-body
          .staff.chord-staff{"data-id" => chord.id, "data-easyscore" => chord.staff_easyscore, "data-clef" => "treble", "data-width" => 150, "data-height" => 150}

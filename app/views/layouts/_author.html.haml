-# full: about page version, with blog articles and contact
- full = local_assigns.fetch(:full, false)
- guitar_url = 'https://www.camilleroux.com/comment-jai-appris-la-guitare-electrique-en-6-mois/'
- production_url = 'https://www.camilleroux.com/se-former-a-la-production-de-musique-electronique-et-publier-un-morceau-en-moins-dun-an/'

%aside.author.card{'aria-label': "L'auteur"}
  .card-body
    .author__header
      = image_tag ApplicationHelper::AUTHOR_PHOTO_URL, alt: 'Camille Roux', width: 104, height: 104, loading: 'lazy', class: 'author__photo'
      %div
        %p.author__eyebrow Auteur
        %p.author__name= link_to 'Camille Roux', 'https://www.camilleroux.com/', rel: 'author', title: 'Site personnel de Camille Roux'
        %p.author__role Entrepreneur, développeur et musicien amateur
    %p.author__bio
      = typo_fr("J'ai créé ce site en 2015 pour rassembler la théorie musicale utile au jazz et à l'improvisation. Je joue de la guitare et je produis de la musique électronique.")
    - if full
      %p.author__bio
        = typo_fr("Je compose aussi mes propres morceaux, et la théorie finit souvent par s'y glisser.")
        = succeed ',' do
          = link_to 'Ear Rebirth', 'https://music.camilleroux.com/albums/ear-rebirth/'
        = typo_fr('un morceau sur mes acouphènes, commence et se termine en 19/8, avec un passage en 6/8 au milieu.')
      %p.author__subtitle Sur mon blog
      %ul.author__articles
        %li= link_to "Comment j'ai appris la guitare électrique en 6 mois", guitar_url
        %li= link_to "S'initier à la production musicale et publier un morceau en moins d'un an", production_url
    - else
      %p.author__bio
        = typo_fr('À lire sur mon blog :')
        = link_to "comment j'ai appris la guitare électrique en 6 mois", guitar_url
    .author__actions
      = link_to 'Mon site personnel', 'https://www.camilleroux.com/', class: 'btn btn-primary btn-sm', rel: 'author'
      = link_to 'Écouter mes morceaux', 'https://music.camilleroux.com/', class: 'btn btn-outline-primary btn-sm', rel: 'noopener'
      - if full
        %span.author__contact
          = typo_fr('Une remarque ? Écrivez-moi sur')
          = link_to 'X', 'https://x.com/CamilleRoux', rel: 'noopener nofollow'
          ou
          = succeed '.' do
            = link_to 'Bluesky', 'https://bsky.app/profile/camilleroux.com', rel: 'noopener me'
      - else
        = link_to 'À propos de ce site', page_path('a-propos'), class: 'btn btn-link btn-sm'

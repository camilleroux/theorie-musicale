<!DOCTYPE html>
%html{lang:'fr'}
  = render :partial => 'layouts/head'

  %body
    %nav.navbar.sticky-top.navbar-expand-md.navbar-dark.bg-dark
      .container
        %button.navbar-toggler{"aria-controls" => "navbarText", "aria-expanded" => "false", "aria-label" => "Toggle navigation", "data-bs-target" => "#navbarText", "data-bs-toggle" => "collapse", :type => "button"}
          %span.navbar-toggler-icon
        =link_to "Théorie musicale", root_path, class: "navbar-brand", title: "Théorie de la musique"
        #navbarText.collapse.navbar-collapse
          %ul.navbar-nav.me-auto
            %li.nav-item=link_to 'Notes', notes_path, title: 'Liste des notes', class:'nav-link'
            %li.nav-item=link_to 'Intervalles', intervals_path, title: 'Liste des intervalles', class:'nav-link'
            %li.nav-item=link_to 'Accords', chords_path, title: 'Liste des accords', class:'nav-link'
            %li.nav-item=link_to 'Gammes', scales_path, title: 'Gammes et leurs modes', class:'nav-link'
            %li.nav-item=link_to 'Progressions', progressions_path, title: "Progressions d'accords : II-V-I, anatole, blues...", class:'nav-link'
            %li.nav-item=link_to 'Ressources', page_path('ressources'), title: 'Livres, vidéos, sites... sur la théorie musicale', class:'nav-link'
          %ul.nav.navbar-nav.ms-auto
            %li.nav-item=link_to 'A propos', page_path('a-propos'), title: 'A propos de ce site', class:'nav-link'


    #content-wrapper
      .container
        = yield

  %footer
    Créé avec ♥ par
    =link_to "Camille Roux", "https://www.camilleroux.com/", target: '_blank', title: "Site personnel de Camille Roux", rel: 'author me'
    \•
    =link_to "Écouter ma musique", "https://music.camilleroux.com/", target: '_blank', title: "Musique de Camille Roux", rel: 'noopener'
    \•
    =link_to "Code source", "https://github.com/camilleroux/theorie-musicale", target: '_blank', rel: 'nofollow noopener'

    -# Javascript at the bottom for fast page loading
  = render :partial => 'layouts/javascripts_bottom'

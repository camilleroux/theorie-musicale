%head
  %meta{charset:"utf-8"}
  %meta{'http-equiv' => "X-UA-Compatible", content:"IE=edge"}
  %meta{name:"viewport",content:"width=device-width, initial-scale=1, shrink-to-fit=no"}
  = display_meta_tags :site => 'Théorie musicale',
                      :description => 'Théorie de la musique (accords, gammes, modes...) pour le jazz et les musiques improvisées',
                      :keywords => 'gamme, accord, mode, intervalle, majeur, mineur, jazz, improvisation, théorie',
                      :reverse => true,
                      :author => 'https://www.camilleroux.com/',
                      :og => { title: :title,
                        :type  => :website,
                        :site_name => 'Théorie musicale',
                        :locale => "fr_FR",
                        :url => :canonical,
                        :description => :description},
                      :twitter => { card: 'summary',
                        :site => '@CamilleRoux',
                        :creator => '@CamilleRoux'}

  = favicon_link_tag
  %link{rel: "preconnect", href: "https://fonts.googleapis.com"}
  %link{rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: true}
  <link href="//fonts.googleapis.com/css?family=Lato:400,300,700,900|Merriweather:300italic,300,700,700italic" rel="stylesheet" type="text/css">
  <meta name="google-site-verification" content="SueIOm5OP8R5QoMCc_V3ODVd-jZZeynl1iE17FXH8vc" />
  = render :partial => 'layouts/stylesheets'

  = javascript_include_tag 'application', 'data-turbolinks-track' => true
  = csrf_meta_tags

  = render partial: "layouts/ga", locals: {google_account_id: 'UA-67702685-1'}

:plain
  <script type="application/ld+json">
  {
    "@context" : "https://schema.org",
    "@type" : "WebSite",
    "name" : "Théorie Musicale",
    "url" : "#{root_url}",
    "author" : {
      "@type" : "Person",
      "name" : "Camille Roux",
      "url" : "https://www.camilleroux.com/",
      "sameAs" : [
        "https://music.camilleroux.com/",
        "https://art.camilleroux.com/",
        "https://twitter.com/CamilleRoux",
        "https://bsky.app/profile/camilleroux.com"
      ]
    }
  }
  </script>
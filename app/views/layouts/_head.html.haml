%head
  %meta{charset:"utf-8"}
  %meta{'http-equiv' => "X-UA-Compatible", content:"IE=edge"}
  %meta{name:"viewport",content:"width=device-width, initial-scale=1, shrink-to-fit=no"}
  -# Double-sharp/flat keys have no search demand and duplicate their enharmonic pages
  - set_meta_tags noindex: true if @key&.double_altered?
  = display_meta_tags :site => 'Théorie musicale',
                      :description => 'Théorie de la musique (accords, gammes, modes...) pour le jazz et les musiques improvisées',
                      :keywords => 'gamme, accord, mode, intervalle, majeur, mineur, jazz, improvisation, théorie',
                      :reverse => true,
                      :author => 'https://www.camilleroux.com/',
                      :og => { title: :title,
                        :type  => :website,
                        :site_name => 'Théorie musicale',
                        :locale => "fr_FR",
                        :url => :canonical,
                        :image => { _: image_url('/og-image.png'), width: 1200, height: 630, alt: "Théorie musicale : accords, gammes et modes pour le jazz" },
                        :description => :description},
                      :twitter => { card: 'summary_large_image',
                        :site => '@CamilleRoux',
                        :creator => '@CamilleRoux'}

  = favicon_link_tag
  %link{rel: "preconnect", href: "https://fonts.googleapis.com"}
  %link{rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: true}
  -# Inter lacks ♯ ♭ ♮: browsers fall back to the system symbol font, which renders them better than Noto Music
  %link{rel: 'stylesheet', href: 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&display=swap'}
  <meta name="google-site-verification" content="SueIOm5OP8R5QoMCc_V3ODVd-jZZeynl1iE17FXH8vc" />
  = render :partial => 'layouts/stylesheets'

  = javascript_include_tag 'application'
  = csrf_meta_tags
  %script{type: 'application/ld+json'}= structured_data.to_json.html_safe

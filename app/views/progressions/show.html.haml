-title @progression.seo_title
-description @progression.seo_description
-set_meta_tags canonical: progression_url(@progression)

%ol.breadcrumb
  %li.breadcrumb-item= link_to 'Théorie musicale', root_path
  %li.breadcrumb-item= link_to 'Progressions', progressions_path
  %li.breadcrumb-item.active= @progression.short_name

%article#progression
  .page-header
    %h1= @progression.name
    %p.lead.text-muted= @progression.roman_numerals
  %p.lead= typo_fr(@progression.summary)

  - if @progression.bars
    %section.mt-4
      %h2.h3 Grille en #{@tonic.french_long_name}
      %nav.key-selector.mb-3{'aria-label': 'Tonalité'}
        %span.key-selector__label Tonalité
        %ul.pagination.pagination-sm
          - @tonics.each do |tonic|
            %li.page-item{class: ('active' if tonic == @tonic)}
              = link_to tonic, progression_path(@progression, tonalite: (tonic.to_param unless tonic.main?)), class: 'page-link', 'aria-current': (tonic == @tonic ? 'page' : nil)
      .row.g-2.text-center
        - @progression.bars.each_with_index do |step_index, bar|
          .col-3
            .card.mb-0
              .card-body.py-3
                .small.text-muted Mesure #{bar + 1}
                .fs-5.fw-bold= render 'chord_link', chord: @grid_chords[step_index]

  %section.mt-4
    - @progression.paragraphs.each do |paragraph|
      %p= typo_fr(paragraph)

  %section.mt-4
    %h2.h3 #{@progression.short_name} dans les 12 tonalités
    .table-responsive
      %table.table.table-hover.table-striped
        %thead
          %tr
            %th Tonalité
            - @progression.steps.each do |step|
              %th= step.roman
        %tbody
          - @tonics.each do |tonic|
            %tr
              %th= link_to "#{tonic} (#{tonic.french_long_name})", note_path(tonic), class: 'text-decoration-none'
              - @progression.chords_in(tonic).each do |chord|
                %td= render 'chord_link', chord: chord

  %nav.mt-5
    %h2.h4 Autres progressions
    %ul
      - (Progression.all - [@progression]).each do |progression|
        %li= link_to progression.name, progression_path(progression)

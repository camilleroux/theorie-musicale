-set_meta_tags canonical: notes_url

%ol.breadcrumb{itemscope: true, itemtype: "https://schema.org/BreadcrumbList"}
  %li.breadcrumb-item{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: root_path, title: "Théorie de la musique"}
      %span{itemprop: "name"}>= "Théorie musicale"
    %meta{itemprop: "position", content: "1"}
  %li.breadcrumb-item.active{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: notes_path, title: "Notes", class: "disable"}
      %span{itemprop: "name"}>="Notes"
    %meta{itemprop: "position", content: "2"}

.page-header
  %h1= title "Notes"
%h2.lead= description 'Liste des notes et de leurs équivalents enharmoniques'

#section#notes
  .table-responsive
    %table.table.table-hover
      %thead
        %tr
          %th Note
          %th Notation anglaise
          %th Notation française

      %tbody
      -(0...12).each do |index|
        -@keys.select {|key| key.index == index}.each do |key|
          %tr{class: key.index.even? ? "table-active" : ""}
            %td
              %strong= link_to key, note_path(key), title: key.name_for_seo
            %td
              =key.name
            %td
              =key.french_name


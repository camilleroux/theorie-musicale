-set_meta_tags canonical: notes_url

%ol.breadcrumb{itemscope: true, itemtype: "https://schema.org/BreadcrumbList"}
  %li.breadcrumb-item{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: root_path, title: "Théorie de la musique"}
      %span{itemprop: "name"}>= "Théorie musicale"
    %meta{itemprop: "position", content: "1"}
  %li.breadcrumb-item.active{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: notes_path, title: "Notes", class: "disable"}
      %span{itemprop: "name"}>="Notes"
    %meta{itemprop: "position", content: "2"}

.page-header
  %h1= title "Notes"
  %p.lead= description 'Les notes et leurs équivalents enharmoniques, en notation anglaise et française'

%p.text-muted Les notes regroupées par touche du clavier. En bleu les noms usuels, en contour les écritures avec double dièse ou double bémol.
.group-list.card
  - (0...12).each do |index|
    - keys = @keys.select { |key| key.index == index }
    - usual = keys.reject(&:double_altered?).sort_by { |key| key.name.include?('♭') ? 1 : 0 }
    - naturals = usual.reject(&:altered?)
    .group-list__row
      .group-list__label
        %strong= (naturals.presence || usual).map(&:french_name).join(' / ')
        %span= naturals.any? ? 'Touche blanche' : 'Touche noire'
      .group-list__items
        - keys.sort_by { |key| [key.double_altered? ? 1 : 0, key.altered? ? 1 : 0, key.name.include?('♭') ? 1 : 0] }.each do |key|
          = link_to note_path(key), class: "chip #{key.double_altered? ? 'chip--alt' : 'chip--main'}", title: key.name_for_seo do
            %span.chip__name= key.name
            %span.chip__note= key.french_long_name

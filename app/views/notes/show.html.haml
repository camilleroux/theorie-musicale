-title @key.seo_title
-description @key.seo_description
-set_meta_tags canonical: note_url(@key)

%ol.breadcrumb{itemscope: true, itemtype: "https://schema.org/BreadcrumbList"}
  %li.breadcrumb-item{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: root_path, title: "Théorie de la musique"}
      %span{itemprop: "name"}>= "Théorie musicale"
    %meta{itemprop: "position", content: "1"}
  %li.breadcrumb-item{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: notes_path, title: "Notes"}
      %span{itemprop: "name"}>= "Notes"
    %meta{itemprop: "position", content: "2"}
  %li.breadcrumb-item.active{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: note_path(@key), title: @key.name_for_seo, class: "disable"}
      %span{itemprop: "name"}>= @key.name
    %meta{itemprop: "position", content: "3"}

%header.detail-hero.card
  .card-body
    .row.g-4.align-items-center
      .col-12.col-lg-6
        %h1.detail-hero__title
          %span.detail-hero__symbol= @key.name
          = ' '
          %span.detail-hero__name Note #{@key.french_long_name}
        %dl.detail-hero__facts
          %dt Nom complet
          %dd= @key.long_name
          %dt En français
          %dd= @key.french_long_name
          - enharmonics = Key.all.uniq(&:name).select { |key| key.index == @key.index && key.name != @key.name }
          - if enharmonics.any?
            %dt Enharmonies
            %dd
              - enharmonics.each do |key|
                = link_to key, note_path(key), title: key.name_for_seo, class: 'badge bg-light'
      .col-12.col-lg-6
        .detail-hero__staff
          .staff.note-staff{"data-id" => @key.to_param, "data-staff" => ["#{@key.to_vexflow_notation}"].to_json, "data-staff-clef" => "treble", "width" => 200}

%section#piano
  %h2.h3 Note #{@key.name} au piano
  = piano_image_tag(@key)

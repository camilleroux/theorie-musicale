-title @key.seo_title
-description @key.seo_description
-set_meta_tags canonical: note_url(@key)

%ol.breadcrumb{itemscope: true, itemtype: "https://schema.org/BreadcrumbList"}
  %li.breadcrumb-item{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: root_path, title: "Théorie de la musique"}
      %span{itemprop: "name"}>= "Théorie musicale"
    %meta{itemprop: "position", content: "1"}
  %li.breadcrumb-item{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: notes_path, title: "Notes"}
      %span{itemprop: "name"}>= "Notes"
    %meta{itemprop: "position", content: "2"}
  %li.breadcrumb-item.active{itemprop: "itemListElement", itemscope: true, itemtype: "https://schema.org/ListItem"}
    %a{itemprop: "item", href: note_path(@key), title: @key.name_for_seo, class: "disable"}
      %span{itemprop: "name"}>= @key.name
    %meta{itemprop: "position", content: "3"}

.page-header
  %h1
    = @key.name
    %small.text-muted= @key.french_name

%section#note
  .row
    .col-12.col-md-3
      .card
        .card-header
          Notation
        .card-body
          .staff.note-staff.img-fluid{"data-id" => @key.to_param, "data-staff" => ["#{@key.to_vexflow_notation}"].to_json, "data-staff-clef" => "treble", "width" => 223}

%section#infos.mt-3
  %h3 Informations complémentaires
  %p
    %label Nom complet :
    = @key.long_name
  %p
    %label Notation française :
    = @key.french_name
  %p
    %label Enharmonies :
    - Key.all.uniq{ |key| key.name }.select {|key| key.index == @key.index}.each do |key|
      = link_to key, note_path(key), title: key.name_for_seo

%section#piano.mt-3
  %h3 Note #{@key.name} au piano
  = piano_image_tag(@key)
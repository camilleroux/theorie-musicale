-title @key.seo_title
-description @key.seo_description
-set_meta_tags canonical: note_url(@key)
- add_defined_term(name: "Note #{@key.name} (#{@key.french_long_name})", code: @key.name, description: @key.seo_description.sub(/ Position .*\z/, ''),
  url: note_url(@key), set_name: 'Notes', set_url: notes_url, alternate_names: [@key.french_long_name])

= breadcrumb(['Notes', notes_path], ["Note #{@key.name}", note_path(@key)])

%header.detail-hero.card
  .card-body
    .row.g-4.align-items-center
      .col-12.col-lg-6
        %h1.detail-hero__title
          %span.detail-hero__kicker Note
          = ' '
          %span.detail-hero__symbol= @key.name
          = ' '
          %span.detail-hero__name #{@key.french_long_name} en notation française
        %dl.detail-hero__facts
          %dt Nom complet
          %dd= @key.long_name
          %dt En français
          %dd= @key.french_long_name
          - if CircleOfFifths::SIGNATURES.key?(@key.name)
            %dt Tonalité
            %dd= link_to "#{@key.french_long_name} majeur", key_path(@key)
          - enharmonics = Key.all.uniq(&:name).select { |key| key.index == @key.index && key.name != @key.name }
          - if enharmonics.any?
            %dt Enharmonies
            %dd
              - enharmonics.each do |key|
                = link_to key, note_path(key), title: key.name_for_seo, class: 'badge bg-light'
      .col-12.col-lg-6
        .detail-hero__staff
          .staff.note-staff{"data-id" => @key.to_param, "data-staff" => ["#{@key.to_vexflow_notation}"].to_json, "data-staff-clef" => "treble", "width" => 200}
          = play_buttons([@key.to_vexflow_notation], :chord)

%section.detail-intro
  %p.lead= typo_fr(@key.seo_description.sub(/ Position .*\z/, ""))

%section#piano
  %h2.h3 Note #{@key.name} au piano
  = piano_image_tag(@key)

= render 'shared/faq', title: "Questions sur la note #{@key.name}", items: Faq.for_note(@key)
